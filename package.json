{
  "name": "universal-polling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Universal Date Polling — a free group scheduler. Create a poll, share a link, find the time that works for everyone.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "credits": "node ../scripts/gen-credits.mjs . --repo https://github.com/universal-simulation-ltd/Universal_Date_Polling",
    "test": "vitest run",
    "test:booking": "node e2e/booking.e2e.mjs",
    "test:confirmed": "node e2e/confirmed.e2e.mjs",
    "test:editing": "node e2e/editing.e2e.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:mobile": "npm run build:desktop",
    "check:mobile-bundle": "node scripts/verify-mobile-bundle.mjs",
    "check:ios-launch": "node scripts/verify-ios-launch.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync && npm run check:mobile-bundle && npm run check:ios-launch",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@supabase/supabase-js": "^2.47.10",
    "@unisim/media": "^0.7.0",
    "@unisim/sdk": "^0.166.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
